# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
AGENT_NAME=小深

# Router 用轻量模型 + 关闭思考；Worker 默认 Flash，复杂任务自动切 Pro
ROUTER_MODEL=deepseek-flash
WORKER_MODEL=deepseek-flash
WORKER_MODEL_HEAVY=deepseek-v4-pro
ROUTER_THINKING=disabled
WORKER_THINKING=enabled
REASONING_EFFORT=high

MAX_WORKERS=3
MAX_STEPS=8
AGENT_ALLOW_WRITE=false

# DeepSeek Harness 作为 Worker 执行后端（未安装 dsh 时自动回退到内置 Worker）
# 注意：不要使用 DSH_ 前缀，DSH 会拒绝工作区 .env 中的保留变量
HARNESS_ENABLED=false
HARNESS_POLICY_VERIFIED=false
HARNESS_COMMAND=dsh
HARNESS_PROFILE=headless
HARNESS_PROVIDER=deepseek-official
HARNESS_TIMEOUT=1800
# 可选：仅当 Harness 需要自定义接口地址时填写；留空使用 Harness 默认值
HARNESS_BASE_URL=
# 可选：当前 dsh headless 若支持额外参数，可在这里追加，例如 --permission-mode workspace-write
HARNESS_EXTRA_ARGS=
# HARNESS_HOME=

# 三项主动能力在网页管理员侧栏分别启用，默认关闭。
# 默认数据保存到本机 LOCALAPPDATA/basic-chat/<工作区标识>，不进入仓库。
# CHAT_DATA_DIR=
TASK_TIMEOUT=600
HEARTBEAT_INTERVAL=10
STALL_SECONDS=180
